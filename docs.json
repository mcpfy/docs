{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "MCPfy AI",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/mcpfy-fav-icon-min.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "MCPfy Documentation",
            "pages": [
              {
                "group": "Getting started",
                "expanded": false,
                "pages": [
                  "create-server",
                  "support"
                ]
              },
              {
                "group": "MCPfy Cloud",
                "expanded": false,
                "pages": [
                  "mcpfy-cloud/deployment-from-github/deployment"
                ]
              },
              {
                "group": "MCPfy SDK",
                "expanded": false,
                "pages": [
                  "mcpfy-sdk/getting-started",
                  "mcpfy-sdk/architecture",
                  "mcpfy-sdk/server",
                  "mcpfy-sdk/client",
                  "mcpfy-sdk/tools",
                  "mcpfy-sdk/prompts",
                  "mcpfy-sdk/resources",
                  "mcpfy-sdk/widgets",
                  "mcpfy-sdk/widget-react",
                  "mcpfy-sdk/authentication",
                  "mcpfy-sdk/api-reference",
                  "mcpfy-sdk/claude-skill"
                ]
              },
              {
                "group": "Pulse SDK",
                "expanded": false,
                "pages": [
                  "pulse-sdk/overview",
                  "pulse-sdk/typescript",
                  "pulse-sdk/python",
                  "pulse-sdk/dashboard"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/authentication"
            ]
          },
          {
            "group": "MCP Servers",
            "pages": [
              "api-reference/endpoint/list-servers"
            ]
          },
          {
            "group": "Generate MCP URL",
            "pages": [
              "api-reference/endpoint/generate-url"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://docs.mcpfy.ai",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mcpfy.ai/blog/",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/mcpfy-logo-light.png",
    "dark": "/logo/mcpfy-logo-dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Homepage",
        "href": "https://mcpfy.ai"
      },
      {
        "label": "Support",
        "href": "http://localhost:3003/support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://mcpfy.ai/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/mcpfy/"
    }
  }
}